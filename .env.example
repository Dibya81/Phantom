# PhantomID — Environment Variables Example
# Copy this to .env and fill in the values for full system integration.

# ── Blockchain (Solana + Pinata) ──────────────────────────────────────────────
SOLANA_WALLET_PATH=~/.config/solana/id.json
SOLANA_RPC_URL=https://api.devnet.solana.com
ANCHOR_PROGRAM_ID=YourAnchorProgramIdHere
PINATA_JWT=YourPinataJwtHere

# ── Database (Supabase) ───────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Intelligence (Groq LLM) ──────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# ── Notifications (Meta/WhatsApp) ─────────────────────────────────────────────
WHATSAPP_TOKEN=your-meta-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-id

# ── Authentication (Google OAuth) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/connect-gmail/callback

# ── Deployment ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
PORT=8000