{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "threat_assessment.schema.json",
  "title": "ThreatAssessment",
  "description": "Produced by the agent reason node. Input to Person 2's proof generation service.",
  "type": "object",
  "required": ["user_pseudonym", "threat_summary", "matches", "risk_level", "context_signals", "timestamp"],
  "additionalProperties": false,
  "properties": {
    "user_pseudonym": {
      "type": "string",
      "description": "SHA-256 hex of user_id — NEVER raw PII",
      "pattern": "^[a-f0-9]{64}$"
    },
    "threat_summary": {
      "type": "string",
      "description": "LLM-generated 1–3 sentence summary of the threat"
    },
    "matches": {
      "type": "array",
      "description": "Array of BreachMatch objects",
      "items": {
        "type": "object",
        "required": ["source", "date", "exposed_fields", "confidence", "raw_preview"],
        "additionalProperties": false,
        "properties": {
          "source": { "type": "string" },
          "date": { "type": "string", "format": "date-time" },
          "exposed_fields": {
            "type": "array",
            "items": { "type": "string" }
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "raw_preview": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "risk_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "context_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp"
    }
  }
}
